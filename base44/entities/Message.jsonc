{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID linking messages in the same conversation"
    },
    "partner_id": {
      "type": "string",
      "description": "The partner entity ID involved in the conversation"
    },
    "partner_user_id": {
      "type": "string",
      "description": "User account ID of the partner (created_by_id of the partner entity)"
    },
    "client_user_id": {
      "type": "string",
      "description": "User ID of the client (non-partner) in the conversation"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "user",
        "partner"
      ],
      "description": "Whether sender is a regular user or the partner"
    },
    "subject": {
      "type": "string",
      "description": "Message subject (for first message)"
    },
    "body": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "inquiry",
        "hire_request",
        "reply"
      ],
      "description": "Type of message"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    },
    "hire_details": {
      "type": "string",
      "description": "Details about the hire request (project scope, budget, timeline)"
    },
    "client_full_name": {
      "type": "string",
      "description": "Full name of the client submitting the contact form"
    },
    "client_email": {
      "type": "string",
      "description": "Business email of the client submitting the contact form"
    },
    "client_budget": {
      "type": "string",
      "description": "Client's budget for the project"
    },
    "client_store_url": {
      "type": "string",
      "description": "Client's Shopify store URL"
    },
    "client_country": {
      "type": "string",
      "description": "Client's country"
    },
    "client_service": {
      "type": "string",
      "description": "Service the client is interested in"
    },
    "collaborator_code": {
      "type": "string",
      "description": "Shopify collaborator code provided by the client"
    }
  },
  "required": [
    "partner_id",
    "body",
    "sender_role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.client_user_id": "{{user.id}}"
        },
        {
          "data.partner_user_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}