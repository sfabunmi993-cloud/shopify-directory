{
  "name": "Payment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who made the payment"
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the user"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "partner_id": {
      "type": "string",
      "description": "ID of the partner being paid"
    },
    "partner_name": {
      "type": "string",
      "description": "Name of the partner"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount in USD"
    },
    "description": {
      "type": "string",
      "description": "What the payment is for"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Admin approval status"
    },
    "admin_note": {
      "type": "string",
      "description": "Admin note on the payment"
    },
    "conversation_id": {
      "type": "string",
      "description": "Linked conversation ID if any"
    },
    "pending_reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the partner has already been notified that this payment is still pending after 48 hours"
    }
  },
  "required": [
    "user_id",
    "amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}