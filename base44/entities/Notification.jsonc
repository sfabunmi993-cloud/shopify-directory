{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who should receive this notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "content": {
      "type": "string",
      "description": "Notification body text"
    },
    "type": {
      "type": "string",
      "enum": [
        "payment",
        "message",
        "system",
        "admin"
      ],
      "default": "system",
      "description": "Category of this notification"
    },
    "action_url": {
      "type": "string",
      "description": "Optional in-app route to open when the notification is tapped"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has read this notification"
    }
  },
  "required": [
    "user_id",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}