{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "co_admin_role": {
      "type": "string",
      "description": "Permission scope for co-admins (set when they accept a co-admin invite). Undefined for the original platform admin means full access.",
      "enum": [
        "payment_notifications",
        "partners_moderator",
        "marketing_admin",
        "full_admin"
      ]
    }
  },
  "required": [
    "role"
  ]
}