{
  "name": "AdPromotion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Ad headline"
    },
    "content": {
      "type": "string",
      "description": "Ad short body text shown in popup"
    },
    "full_description": {
      "type": "string",
      "description": "Full detailed description shown on the ad detail page"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image URL"
    },
    "video_url": {
      "type": "string",
      "description": "Optional video URL"
    },
    "button_text": {
      "type": "string",
      "description": "CTA button label"
    },
    "button_url": {
      "type": "string",
      "description": "URL the button links to (external)"
    },
    "website_url": {
      "type": "string",
      "description": "Advertiser website URL shown on detail page"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email shown on detail page"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone shown on detail page"
    },
    "bg_color": {
      "type": "string",
      "default": "#ffffff",
      "description": "Background color (hex)"
    },
    "text_color": {
      "type": "string",
      "default": "#111827",
      "description": "Text color (hex)"
    },
    "button_color": {
      "type": "string",
      "default": "#166534",
      "description": "Button color (hex)"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether this ad is currently live"
    }
  },
  "required": [
    "title",
    "button_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}