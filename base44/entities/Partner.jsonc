{
  "name": "Partner",
  "type": "object",
  "properties": {
    "partner_number": {
      "type": "string",
      "description": "Auto-generated unique partner ID (e.g. PB-00042)"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique identifier derived from partner name"
    },
    "name": {
      "type": "string",
      "description": "Partner/agency name"
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the partner's logo"
    },
    "description": {
      "type": "string",
      "description": "Short description of the partner"
    },
    "full_description": {
      "type": "string",
      "description": "Detailed description of partner services"
    },
    "location": {
      "type": "string",
      "description": "City, Country"
    },
    "country": {
      "type": "string",
      "description": "Country name for filtering"
    },
    "rating": {
      "type": "number",
      "description": "Average rating out of 5"
    },
    "review_count": {
      "type": "number",
      "description": "Total number of reviews"
    },
    "starting_price": {
      "type": "number",
      "description": "Starting price in USD"
    },
    "services": {
      "type": "array",
      "description": "List of services offered",
      "items": {
        "type": "string"
      }
    },
    "service_descriptions": {
      "type": "object",
      "description": "Map of service name to its description",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "description": "Searchable tags/keywords",
      "items": {
        "type": "string"
      }
    },
    "service_category": {
      "type": "string",
      "enum": [
        "marketing_and_sales",
        "store_setup_and_management",
        "development_and_troubleshooting",
        "visual_content_and_branding",
        "content_writing",
        "expert_guidance"
      ],
      "description": "Primary service category"
    },
    "industry": {
      "type": "string",
      "enum": [
        "technology",
        "healthcare",
        "finance",
        "retail",
        "education",
        "manufacturing",
        "real_estate",
        "hospitality",
        "creative",
        "other"
      ],
      "description": "Industry specialization"
    },
    "partner_tier": {
      "type": "string",
      "enum": [
        "standard",
        "plus",
        "premium"
      ],
      "default": "standard",
      "description": "Partner tier level"
    },
    "website_url": {
      "type": "string",
      "description": "Partner's website URL"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "whatsapp_url": {
      "type": "string",
      "description": "WhatsApp link"
    },
    "dashboard_screenshot_url": {
      "type": "string",
      "description": "URL of the partner's Shopify Partner Dashboard screenshot"
    },
    "completed_projects": {
      "type": "number",
      "description": "Number of completed projects"
    },
    "languages": {
      "type": "array",
      "description": "Languages spoken",
      "items": {
        "type": "string"
      }
    },
    "years_as_partner": {
      "type": "number",
      "description": "Number of years the partner has been working as a Shopify partner",
      "default": 0
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this partner is featured"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether this partner has been verified by admin"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Whether this partner is hidden from the directory by admin"
    },
    "unlimited_reviews": {
      "type": "boolean",
      "default": false,
      "description": "Whether this partner is approved for unlimited review purchases"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "restricted"
      ],
      "default": "pending",
      "description": "Account status"
    },
    "flag_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this partner has been flagged"
    },
    "restriction_reason": {
      "type": "string",
      "description": "Reason for account restriction by admin"
    },
    "admin_banner": {
      "type": "string",
      "description": "Custom banner message set by admin, visible only to this partner on their profile"
    }
  },
  "required": [
    "name",
    "service_category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}