{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who saved the favorite"
    },
    "partner_id": {
      "type": "string",
      "description": "ID of the favorited partner"
    },
    "description": {
      "type": "string",
      "description": "Optional note about why this partner was saved (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "partner_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}